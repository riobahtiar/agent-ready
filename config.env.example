# config.env — AgentReady machine settings for install.sh. Easiest: ./install.sh --configure
# (asks for everything). By hand: copy to config.env (git-ignored) and edit.
# Bash syntax: KEY=value, quote values with spaces. A nonempty exported
# variable overrides its key (e.g. TIMEZONE=UTC ./setup-server.sh); install
# runs save valid overrides here, secrets included (--help/--list/--status
# don't). Not overrides: values a parent AgentReady command (vps, the settings
# wizard) passed down, values equal to ~/.config/secrets.env, and the login
# shell's PROJECTS_DIR — change those here or with ./install.sh --configure.
# Re-run the stage that uses a value after changing it (./install.sh --changed).
# Every key and its default: docs/10-reference.md → "config.env".

# ─── Identity ───
TARGET_USER=
GIT_NAME="Your Name"
GIT_EMAIL="you@example.com"
# Optional: raises GitHub's API limit for mise/gh installs (60/h unauthenticated).
# A fine-grained token with no permissions is enough.
GITHUB_TOKEN=

# ─── Machine ───
PROFILE=                        # server | desktop (empty = desktop on macOS/WSL/GUI Linux, else server) — or use setup-server.sh / setup-desktop.sh
TIMEZONE=UTC
LOCALE=en_US.UTF-8
HOSTNAME_FQDN=                  # e.g. server.example.com (empty = keep)
LOGIN_SHELL=fish                # fish | bash
LOGIN_GREETING=true             # server: our SSH greeting (bin/motd) instead of Ubuntu's + the provider's MOTD
CLOUD_INIT_LOCK=true            # server: stop provider cloud-init boot scripts after first boot (some providers re-enable root login each boot)
SWAP_SIZE_GB=4                  # server: disk swapfile behind zram (0 = none)
ZRAM=true                       # server: compressed RAM swap — absorbs bursts with many agents

# ─── Security (server profile) ───
SSH_HARDEN=true                 # key-only auth, once a key login by TARGET_USER has been seen (force = skip that check)
SSH_DISABLE_ROOT=true
OPEN_MOSH=false                 # open UDP 60000-61000 for mosh
F2B_IGNORE_IPS=                 # never banned by fail2ban (your home/office IPs/CIDRs); the installing IP is added automatically

# ─── Network: Tailscale + dev tunnels (stage 75, `tunnel`) ───
TAILSCALE=false                 # install Tailscale; `tunnel` can then share dev servers privately
TAILSCALE_SSH=false             # tailscale up --ssh (SSH over the tailnet, no keys needed)
TAILSCALE_AUTHKEY=              # optional tskey-auth-… for an unattended `tailscale up` (else it prints a URL)
TUNNEL_DEFAULT=auto             # tunnel <port> without a provider: auto | tailscale | ssh | cloudflare | funnel | zrok | pinggy

# ─── Unattended mode: full control (stage 05) ───
# Unattended mode: passwordless sudo for TARGET_USER, Claude + Codex skip
# permission prompts by default, and TARGET_USER is in the docker group.
# Perimeter security stays locked: key-only SSH, no root login, ufw, fail2ban,
# Hermes login. false = sudo asks for a password, agents ask before acting.
# Empty = on for the server profile, off for desktops/laptops.
FULL_CONTROL=

# ─── Containers (stage 30) ───
DOCKER=true                     # Docker Engine on Linux (false: you use Podman/Docker Desktop, or none)
DOCKER_SUDOLESS=                # add you to the docker group (root-equivalent); empty = true for server, false for desktop

# ─── Agent sandboxing (stage 65, `sandbox`) ───
AGENT_SANDBOX=                  # Claude Code's bubblewrap/Seatbelt sandbox (only if you haven't set it); empty = off with FULL_CONTROL, else on
GVISOR=false                    # gVisor (runsc) Docker runtime for `sandbox box` (Debian/Ubuntu)

# ─── Web hosting (server profile) ───
ACME_EMAIL="you@example.com"    # Let's Encrypt account email
PHP=true                        # PHP-FPM + Composer (distro default PHP)
WWW_DIR=/srv/www

# ─── Tooling ───
PROJECTS_DIR=                   # empty = ~/projects
FLUTTER_LINUX_DESKTOP=false     # GTK/clang deps for `flutter build linux`
# Agent CLIs to install — module names from agents.d/ (`agents` lists them).
AGENTS="claude codex opencode omp grok muse herdr"
CLEANUP_TIMER=                  # weekly `cleanup --auto` (systemd); empty = on for server, off for desktop

# ─── Optional desktop apps (stage 85, desktop profile only) ───
# Empty/none = install nothing. Select in ./install.sh --configure, or list IDs.
# Removing an ID does not uninstall an app; no app launches or VPN sign-ins.
# IDs: orbstack tablepro zed ghostty tailscale chatgpt claude helium
#      cloudflare-warp obsidian mole (Mole CLI is macOS-only).
DESKTOP_APPS=

# ─── Hermes agent (server profile) ───
HERMES=true
HERMES_DOMAIN=                  # e.g. hermes.example.com (A record must point at this server; empty = skip public TLS vhost)
HERMES_DASHBOARD_USER=
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_PASSWORD=      # empty = prompted during install (recommended)
HERMES_ALLOW_IPS=               # optional nginx allowlist, space-separated IPs/CIDRs (behind Cloudflare's proxy nginx sees Cloudflare IPs; use HERMES_CLOUDFLARE_ONLY instead)
HERMES_CLOUDFLARE_ONLY=false    # behind Cloudflare Access: accept only Cloudflare's IP ranges, so nobody bypasses Access via the server IP
# Telegram: create a bot with @BotFather, get your numeric id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=         # comma-separated numeric user ids
