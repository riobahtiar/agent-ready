# ~/.config/secrets.env — API keys for agents and tools (chmod 600, never commit).
# POSIX KEY=VALUE: loaded by fish (config.fish) and bash (shell/profile.sh).
# Most agents prefer OAuth sign-in (`claude`, `codex login`, `grok login
# --device-auth`, `muse login`); keys here are for headless/CI use or tools
# that only take a key. Leave unused ones empty.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
META_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Raises GitHub API limits for mise / gh / agents.
GITHUB_TOKEN=

# ─── Cloud CLIs (prefer their own login: `aws configure sso`, `cf auth login
# --no-browser`, `wrangler login`, `rclone config`) — tokens for scripts/CI ───
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AWS_PROFILE=
# notify (Telegram): defaults to the Hermes bot + first TELEGRAM_ALLOWED_USERS id
NOTIFY_TELEGRAM_CHAT=
