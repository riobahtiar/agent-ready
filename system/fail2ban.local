# Managed by ~/.dotfiles (system/fail2ban.local)
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd
# Repeat offenders get a week.
bantime.increment = true
bantime.maxtime   = 1w

[sshd]
enabled = true

[recidive]
enabled  = true
backend  = auto
logpath  = /var/log/fail2ban.log
bantime  = 1w
findtime = 1d
