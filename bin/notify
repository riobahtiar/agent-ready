#!/usr/bin/env bash
# notify — send yourself a Telegram message through the Hermes bot.
#
#   notify "deploy finished"
#   long-build; notify "build exited $?"
#   echo "multi-line text" | notify
#
# Token: TELEGRAM_BOT_TOKEN from ~/.config/secrets.env (a dedicated notify bot),
# else ~/.hermes/.env (the Hermes bot). Chat: NOTIFY_TELEGRAM_CHAT (same file
# order), else the first id in TELEGRAM_ALLOWED_USERS. You must have sent the bot a
# message once. Sending doesn't disturb the Hermes gateway, which only reads
# updates. Hook examples for agents: docs/06-tools-and-agents.md → "Get pinged".
set -Eeuo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

[[ ${1:-} == -h || ${1:-} == --help ]] && {
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

if (($#)); then
    text="$*"
elif [[ ! -t 0 ]]; then
    text="$(cat)"
else
    die "usage: notify <message>   (or pipe text in)"
fi
[[ -n $text ]] || die "empty message"

files=("$HOME/.config/secrets.env" "$HOME/.hermes/.env")
token='' chat=''
for key in TELEGRAM_BOT_TOKEN NOTIFY_TELEGRAM_CHAT TELEGRAM_ALLOWED_USERS; do
    for file in "${files[@]}"; do
        if [[ $key == TELEGRAM_BOT_TOKEN ]]; then
            [[ -n $token ]] || token="$(env_get "$file" "$key")"
        else
            [[ -n $chat ]] || chat="$(env_get "$file" "$key")"
        fi
    done
done
chat=${chat%%,*}
[[ -n $token ]] || die "no TELEGRAM_BOT_TOKEN in ~/.config/secrets.env or ~/.hermes/.env"
[[ -n $chat ]] || die "no chat id: set NOTIFY_TELEGRAM_CHAT (or TELEGRAM_ALLOWED_USERS) in ~/.config/secrets.env or ~/.hermes/.env"

# The token is part of the URL; hand it to curl on stdin so it never shows in `ps`.
printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$token" |
    curl -fsS --max-time 15 -K - -o /dev/null \
        --data-urlencode "chat_id=$chat" \
        --data-urlencode "text=$(hostname -s): ${text:0:4000}" ||
    die "Telegram rejected the message (has the bot seen a message from you yet?)"
