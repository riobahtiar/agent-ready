#!/usr/bin/env bash
# doctor — one-screen health check for this machine.
#   doctor           full report
#   doctor --brief   services, resources and exposure only (used at the end of install.sh)
# Exposure (listening ports) and Certificates run on the server profile only.
set -Eeuo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
source "$DOTFILES_DIR/lib/agents.sh"

BRIEF=0
for arg in "$@"; do
    case $arg in
    -h | --help)
        printf 'Usage: doctor [--brief]\n\nReport machine health; --brief shows services, resources and exposure only.\nExposure and Certificates sections: server profile only.\n'
        exit 0
        ;;
    --brief) BRIEF=1 ;;
    *) die "unknown argument: $arg (see doctor --help)" ;;
    esac
done
load_config
problems=0
bad() {
    printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$*"
    problems=$((problems + 1))
}
good() { printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
meh() { printf '  %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
section() { printf '\n%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
# sudo without prompting; empty output when not allowed.
nsudo() { if is_root; then "$@"; else sudo -n "$@" 2>/dev/null; fi; }

section "System — $(hostname) · $OS_PRETTY$([[ $IS_WSL == 1 ]] && echo ' (WSL)') · $(uname -r) · profile $PROFILE"
if [[ $OS_KIND == linux ]]; then
    read -r load1 _ </proc/loadavg
    cores="$(nproc)"
    awk -v l="$load1" -v c="$cores" 'BEGIN { exit !(l > c * 1.5) }' && bad "load $load1 on $cores cores" || good "load $load1 on $cores cores"

    mem_avail_mb=$(($(awk '/MemAvailable/ {print $2}' /proc/meminfo) / 1024))
    mem_total_mb=$(($(awk '/MemTotal/ {print $2}' /proc/meminfo) / 1024))
    if ((mem_avail_mb < 256 || (mem_total_mb > 0 && mem_avail_mb * 100 / mem_total_mb < 10))); then bad "memory: ${mem_avail_mb} MB available of ${mem_total_mb} MB"; else good "memory: ${mem_avail_mb} MB available of ${mem_total_mb} MB"; fi
    swap_line="$(swapon --show=NAME,SIZE,USED --noheadings 2>/dev/null | tr -s ' ' | paste -sd ',' -)"
    [[ -n $swap_line ]] && good "swap: $swap_line" || meh "no swap active"

    disk_pct="$(df -P / | awk 'NR==2 {gsub("%", "", $5); print $5}')"
    disk_free="$(df -h / | awk 'NR==2 {print $4}')"
    if ((disk_pct >= 85)); then bad "disk: ${disk_pct}% used, $disk_free free — run: cleanup"; else good "disk: ${disk_pct}% used, $disk_free free"; fi
    [[ -f /var/run/reboot-required ]] && meh "reboot required ($(paste -sd ' ' /var/run/reboot-required.pkgs 2>/dev/null | cut -c1-60))"
else
    disk_free="$(df -h / | awk 'NR==2 {print $4}')"
    good "load $(sysctl -n vm.loadavg | awk '{print $2}') on $(sysctl -n hw.ncpu) cores · disk $disk_free free"
fi

if ((HAS_SYSTEMD)); then
    section "Services"
    units=()
    if [[ $PROFILE == server ]]; then
        # Socket-activated on Ubuntu 24.04+, plain ssh.service elsewhere: check the live one.
        ssh_pick=''
        for ssh_unit in ssh.socket ssh.service sshd.service; do
            if systemctl is-active --quiet "$ssh_unit" 2>/dev/null; then
                ssh_pick=$ssh_unit
                break
            fi
            [[ -z ${ssh_first:-} ]] && systemctl cat "$ssh_unit" >/dev/null 2>&1 && ssh_first=$ssh_unit
        done
        ssh_pick=${ssh_pick:-${ssh_first:-}}
        [[ -n $ssh_pick ]] && units+=("$ssh_pick")
        systemctl cat nginx.service >/dev/null 2>&1 && units+=(nginx)
        units+=(fail2ban)
        [[ $OS_FAMILY == debian ]] && units+=(unattended-upgrades)
    fi
    is_true "$DOCKER" && units+=(docker)
    is_true "$CLEANUP_TIMER" && units+=(cloud-cleanup.timer)
    is_true "$TAILSCALE" && units+=(tailscaled)
    [[ $PROFILE == server ]] && is_true "$HERMES" && units+=(hermes-dashboard hermes-gateway)
    for unit in "${units[@]}"; do
        if ! systemctl cat "$unit" >/dev/null 2>&1; then
            meh "$unit not installed"
            continue
        fi
        state="$(systemctl is-active "$unit" 2>/dev/null || true)"
        enabled="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
        case $state in
        active) good "$unit" ;;
        inactive) [[ $enabled == enabled ]] && bad "$unit inactive (enabled)" || meh "$unit not running" ;;
        '') meh "$unit: systemd not reachable" ;;
        *) bad "$unit $state" ;;
        esac
    done
    for fpm in /run/php/php[0-9]*-fpm.sock; do [[ -S $fpm ]] && good "php-fpm ($(basename "$fpm" .sock))"; done
    if ufw_status="$(nsudo ufw status)" && [[ -n $ufw_status ]]; then
        [[ $ufw_status == *"Status: active"* ]] && good "ufw active" || bad "ufw inactive"
    fi

    if [[ $PROFILE == server ]]; then
        section "Exposure (server profile: listening on non-loopback addresses)"
        while read -r addr proc; do
            port=${addr##*:}
            case $port in
            22 | 80 | 443) good "$addr ${proc:-}" ;;
            *) bad "$addr ${proc:-} — public? bind it to 127.0.0.1 and use: site add" ;;
            esac
        done < <(ss -tlnpH 2>/dev/null | awk '
        # loopback, and Tailscale CGNAT 100.64.0.0/10 only (not all of 100/8)
        $4 ~ /^(127\.|\[::1\]|\[::ffff:127)/ { next }
        $4 ~ /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./ { next }
        { p = $6; sub(/.*\(\("/, "", p); sub(/".*/, "", p); print $4, p }' | sort -u)
        # UDP too: often legit (tailscaled, mosh), worth knowing about.
        while read -r addr proc; do
            case $proc in tailscaled | mosh-server | systemd-resolve | chronyd | systemd-timesyn) good "udp $addr $proc" ;; *) meh "udp $addr ${proc:-?} listening publicly" ;; esac
        done < <(ss -ulnpH 2>/dev/null | awk '
        $4 ~ /^(127\.|\[::1\]|\[::ffff:127|\[fe80|fe80)/ { next }
        $4 ~ /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./ { next }
        { p = $0; sub(/.*\(\("/, "", p); sub(/".*/, "", p); if (p == $0) p = ""; print $4, p }' | sort -u)
    fi
fi

if ((! BRIEF)); then
    if [[ $PROFILE == server ]]; then
        section "Certificates (server profile)"
        if certs="$(nsudo certbot certificates 2>/dev/null)" && [[ -n $certs ]]; then
            awk '/Certificate Name:/ {n=$3} /Expiry Date:/ {sub(/.*Expiry Date: /, ""); print n " — " $0}' <<<"$certs" | while read -r line; do
                [[ $line == *INVALID* || $line == *EXPIRED* ]] && bad "$line" || good "$line"
            done
        else
            meh "run 'sudo doctor' (or sudo -v first) to read certificates"
        fi
    fi

    if [[ -n $(env_get "$HOME/.hermes/.env" HERMES_DASHBOARD_BASIC_AUTH_USERNAME 2>/dev/null) ]] || systemctl is-enabled hermes-dashboard >/dev/null 2>&1; then
        section "Hermes"
        if status="$(curl -fsS --max-time 3 http://127.0.0.1:$HERMES_DASHBOARD_PORT/api/status 2>/dev/null)"; then
            [[ $(jq -r '.auth_required' <<<"$status" 2>/dev/null) == true ]] && good "dashboard auth required" || bad "dashboard reachable WITHOUT auth"
        else
            bad "dashboard not answering on 127.0.0.1:$HERMES_DASHBOARD_PORT"
        fi
        [[ -n $(env_get "$HOME/.hermes/.env" TELEGRAM_BOT_TOKEN) ]] && good "telegram token set" || meh "telegram token not set (hermes gateway setup)"
        [[ -n $(env_get "$HOME/.hermes/.env" TELEGRAM_ALLOWED_USERS) ]] && good "telegram allowlist set" || meh "no TELEGRAM_ALLOWED_USERS — anyone can request pairing"
    fi

    section "Toolchain"
    for t in git:--version mise:--version node:--version bun:--version go:version python:--version uv:--version \
        aws:--version wrangler:--version cf:--version rclone:version srt:--version tailscale:version cloudflared:--version \
        php:--version composer:--version flutter:--version docker:--version nginx:-v fish:--version; do
        bin=${t%%:*} flag=${t#*:}
        [[ $PROFILE == desktop && $bin == nginx ]] && continue
        if have "$bin"; then
            v="$(with_timeout 10 "$bin" "$flag" 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)"
            printf '  %-9s %s\n' "$bin" "${v:-?}"
        else
            printf '  %-9s %s\n' "$bin" "$C_DIM(missing)$C_RESET"
        fi
    done

    section "Agents"
    agents_table | sed 's/^/  /'

    section "Disk hogs"
    du -sh "$HOME/.cache" "$HOME/.local/share/mise" "$HOME/.claude" "$HOME/.codex" "$HOME/.hermes" "$PROJECTS_DIR" 2>/dev/null | sort -rh | sed 's/^/  /'
    have docker && docker system df 2>/dev/null | sed 's/^/  /'
    [[ -d $DOTFILES_DIR/.git ]] && [[ -n $(git -C "$DOTFILES_DIR" status --porcelain) ]] &&
        meh "~/.dotfiles has uncommitted changes (an installer may have edited a linked file)"
fi

echo
((problems)) && printf '%s%d problem(s)%s\n' "$C_RED" "$problems" "$C_RESET" || printf '%sall good%s\n' "$C_GREEN" "$C_RESET"
exit $((problems > 0))
