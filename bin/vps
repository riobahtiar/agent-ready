#!/usr/bin/env bash
# vps — the AgentReady management menu for this machine. Every entry calls a regular command,
# printed before it runs, so you learn the direct form as you go.
#
#   vps            menu
#   vps docs       browse the guides in ~/.dotfiles/docs
set -Eeuo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
source "$AGENT_READY_DIR/lib/agents.sh"
source "$AGENT_READY_DIR/lib/ui.sh"
source "$AGENT_READY_DIR/lib/configure.sh"

case ${1:-} in
-h | --help)
    printf 'AgentReady management menu\n\nUsage: vps [docs]\n\nOpen the management menu, or browse the guides with docs.\n'
    exit 0
    ;;
esac
load_config

ui_interactive || die "vps is a menu for humans — scripts and agents: use doctor, site, cleanup, update-all directly"

# run <cmd...> — show the command, run it, never let a failure close the menu.
run() {
    printf '%s  $ %s%s\n' "$C_DIM" "$*" "$C_RESET" >&2
    "$@" || warn "exited with status $?"
}

menu_agents() {
    local choice
    choice="$(ui_choose "Agents" \
        "table|Versions and paths" \
        "login|Sign in to an agent" \
        "update|Update agent CLIs" \
        "herdr|Re-install herdr sidebar integrations" \
        "install|Install an agent" \
        "remove|Uninstall an agent" \
        "new|Add a new agent module (agents.d)" \
        "retire|Retire (sunset) an agent" \
        "back|Back")" || return 0
    case $choice in
    table) run "$AGENT_READY_DIR/bin/agents" ;;
    login) run "$AGENT_READY_DIR/bin/agents" login ;;
    update) run "$AGENT_READY_DIR/bin/update-all" agents ;;
    herdr) run "$AGENT_READY_DIR/bin/agents" herdr ;;
    install) run "$AGENT_READY_DIR/bin/agents" install ;;
    remove) run "$AGENT_READY_DIR/bin/agents" remove ;;
    new) run "$AGENT_READY_DIR/bin/agents" new ;;
    retire) run "$AGENT_READY_DIR/bin/agents" retire ;;
    esac
}

menu_hermes() {
    have hermes || {
        warn "Hermes is not installed — ./install.sh hermes"
        return 0
    }
    local choice code
    choice="$(ui_choose "Hermes (https://${HERMES_DOMAIN:-?})" \
        "status|Status of gateway + dashboard" \
        "setup|Model / provider setup (hermes setup)" \
        "up|Install/refresh the Telegram gateway service (hermes-up)" \
        "pair|Approve a Telegram pairing code" \
        "restart|Restart gateway + dashboard" \
        "logs|Follow the gateway log" \
        "dlogs|Follow the dashboard log" \
        "password|Change the dashboard password" \
        "update|Update Hermes" \
        "back|Back")" || return 0
    case $choice in
    status) run "$AGENT_READY_DIR/bin/hermes-up" status ;;
    setup) run hermes setup ;;
    up) run "$AGENT_READY_DIR/bin/hermes-up" ;;
    pair)
        code="$(ui_input "Pairing code from the Telegram chat")" || return 0
        [[ -n $code ]] && run hermes pairing approve telegram "$code"
        ;;
    restart) run sudo systemctl restart hermes-gateway hermes-dashboard ;;
    logs) run journalctl -u hermes-gateway -f -n 100 ;;
    dlogs) run journalctl -u hermes-dashboard -f -n 100 ;;
    password) run env HERMES_RESET_PASSWORD=1 "$AGENT_READY_DIR/install.sh" hermes ;;
    update) run "$AGENT_READY_DIR/bin/update-all" hermes ;;
    esac
}

menu_logs() {
    local choice
    local -a items=(
        "errors|Everything at warning level or worse (this boot)"
        "docker|Docker daemon"
        "cleanup|Last weekly cleanup run"
    )
    if [[ $PROFILE != desktop ]]; then
        items+=("nginx|nginx error log" "ssh|SSH logins" "fail2ban|fail2ban bans")
    fi
    choice="$(ui_choose "Follow which log? (Ctrl-C to stop)" "${items[@]}" "back|Back")" || return 0
    case $choice in
    errors) run journalctl -b -p warning -f -n 50 ;;
    nginx) run sudo tail -n 50 -F /var/log/nginx/error.log ;;
    docker) run journalctl -u docker -f -n 50 ;;
    ssh) run journalctl -u ssh -f -n 50 ;;
    fail2ban) run sudo tail -n 50 -F /var/log/fail2ban.log ;;
    cleanup) run journalctl -u cloud-cleanup -n 200 --no-pager ;;
    esac
}

menu_cloud() {
    local choice
    choice="$(ui_choose "Cloud CLIs: sign in (tokens stay in each tool's own store)" \
        "aws|AWS: aws configure sso (or plain keys: aws configure)" \
        "cf|Cloudflare cf (all APIs · beta): cf auth login --no-browser" \
        "wrangler|Cloudflare wrangler (Workers/Pages/R2/D1): wrangler login" \
        "cloudflared|Cloudflare Tunnel (named tunnels): cloudflared tunnel login" \
        "rclone|rclone remotes (S3 · R2 · B2 · Drive): rclone config" \
        "gh|GitHub: gh auth login" \
        "tailscale|Tailscale: sudo tailscale up" \
        "zrok|zrok: zrok2 enable <token>" \
        "back|Back")" || return 0
    case $choice in
    aws) if ui_confirm "Use AWS IAM Identity Center (SSO)?" yes; then run aws configure sso --use-device-code; else run aws configure; fi ;;
    cf) run cf auth login --no-browser ;;
    wrangler)
        # wrangler's OAuth callback listens on localhost:8976 — on a VPS, forward it first.
        [[ -n ${SSH_TTY:-} ]] && warn "over SSH: on your laptop run  ssh -N -L 8976:127.0.0.1:8976 $(id -un)@$(hostname -f)  then open the URL"
        run wrangler login
        ;;
    cloudflared) run cloudflared tunnel login ;;
    rclone) run rclone config ;;
    gh) run gh auth login --git-protocol https --web ;;
    tailscale) run sudo tailscale up ;;
    zrok)
        local token
        token="$(ui_password "zrok account token (from zrok.io)")" || return 0
        # zrok only takes the token as an argument (visible in `ps` for a moment).
        [[ -n $token ]] && "$(command -v zrok2 || echo zrok)" enable "$token"
        ;;
    esac
}

menu_settings() {
    local choice file
    choice="$(ui_choose "Settings" \
        "wizard|Machine settings wizard (config.env)" \
        "secrets|Edit API keys (~/.config/secrets.env)" \
        "stage|Install / re-apply / renew (install.sh menu)" \
        "status|Install status: what ran · what changed · what's skipped here" \
        "mise|Edit a global tool group (~/.dotfiles/home/.config/mise/conf.d)" \
        "prompt|Edit the fish prompt (easy-eel settings)" \
        "back|Back")" || return 0
    case $choice in
    wizard) configure_wizard && step "apply with: ./install.sh --changed" ;;
    secrets)
        file="$HOME/.config/secrets.env"
        [[ -f $file ]] || install -m 600 "$AGENT_READY_DIR/secrets.env.example" "$file"
        run "${EDITOR:-nano}" "$file"
        step "new shells pick it up; in this one: exec fish"
        ;;
    stage) run "$AGENT_READY_DIR/install.sh" ;;
    status) run "$AGENT_READY_DIR/install.sh" --status ;;
    mise)
        local -a groups=()
        for file in "$AGENT_READY_DIR"/home/.config/mise/conf.d/*.toml; do groups+=("$file|$(basename "$file")"); done
        file="$(ui_choose "Which group?" "${groups[@]}")" || return 0
        run "${EDITOR:-nano}" "$file" && run mise install
        ;;
    prompt) run "${EDITOR:-nano}" "$AGENT_READY_DIR/home/.config/fish/cloud/prompt.fish" ;;
    esac
}

menu_docs() {
    local -a items=()
    local f title choice
    for f in "$AGENT_READY_DIR"/docs/*.md; do
        title="$(sed -n '1s/^# //p' "$f")"
        items+=("$f|${title:-$(basename "$f")}")
    done
    items+=("$AGENT_READY_DIR/README.md|README (full reference)")
    choice="$(ui_choose "Guides" "${items[@]}")" || return 0
    if have glow; then
        glow --pager "$choice"
    else
        less "$choice"
    fi
}

[[ ${1:-} == docs ]] && {
    menu_docs
    exit 0
}

trap 'echo >&2' INT
while :; do
    up="$(uptime -p 2>/dev/null | sed 's/^up //' || true)"
    items=(
        "doctor|Health check (doctor)"
        "update|Update agents and tools (update-all)"
        "cleanup|Clean up disk · worktrees · processes (cleanup)"
        "agents|Agents: versions · sign in · update"
        "tunnel|Share a dev server: tunnels (tunnel)"
        "sandbox|Sandboxes for agents and untrusted code (sandbox)"
        "cloud|Cloud CLIs: AWS · Cloudflare · rclone · GitHub sign-in"
        "logs|Logs"
        "settings|Settings · API keys · install / renew"
        "docs|Guides (how-to docs)"
    )
    if [[ $PROFILE != desktop ]]; then
        items+=("site|Websites: add · remove · logs (site)" "hermes|Hermes: Telegram · dashboard")
    fi
    choice="$(ui_choose "AgentReady · $(hostname -s)${up:+ · $up} · $(df -h / | awk 'NR==2 {print $4}') free" \
        "${items[@]}" "quit|Quit")" || break
    case $choice in
    doctor) run "$AGENT_READY_DIR/bin/doctor" ;;
    update) run "$AGENT_READY_DIR/bin/update-all" ;;
    cleanup) run "$AGENT_READY_DIR/bin/cleanup" ;;
    site) run "$AGENT_READY_DIR/bin/site" ;;
    agents) menu_agents ;;
    hermes) menu_hermes ;;
    logs) menu_logs ;;
    tunnel)
        case "$(ui_choose "Tunnels" "new|Start a tunnel" "ls|Running tunnels" "stop|Stop a tunnel" "providers|Providers and what they need")" in
        new) run "$AGENT_READY_DIR/bin/tunnel" ;;
        ls) run "$AGENT_READY_DIR/bin/tunnel" ls ;;
        stop) run "$AGENT_READY_DIR/bin/tunnel" stop ;;
        providers) run "$AGENT_READY_DIR/bin/tunnel" providers ;;
        esac
        ;;
    sandbox) run "$AGENT_READY_DIR/bin/sandbox" ;;
    cloud) menu_cloud ;;
    settings) menu_settings ;;
    docs) menu_docs ;;
    quit) break ;;
    esac
    [[ $choice == docs ]] || ui_pause
done
